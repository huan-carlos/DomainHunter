# DomainHunter environment (see README/technical plan §9, RNF-009).
# Never commit real credentials — only the shape of the configuration.

# Dashboard password. Login is always active; every page except /login and
# /logout is gated behind an HttpOnly signed session cookie (12h). When unset
# the default password is "domainhunter" (printed in the web startup log).
# Set this to your own password.
# DOMAINHUNTER_PASSWORD=change-me

# Database path; defaults to data/domainhunter.sqlite at the repo root
# (created automatically, persists across restarts). Server and automations
# share the default when unset.
# DOMAINHUNTER_DB_PATH=/var/lib/domainhunter/domainhunter.sqlite

# Listen address for the API (server) and dashboard (web). Defaults to
# 127.0.0.1 (loopback). Set to 0.0.0.0 to expose the service to the network,
# e.g. behind a reverse proxy or Docker -p mapping on a VPS.
# HOST=127.0.0.1

# SMTP email provider (optional). When unset, email notifications are
# skipped and the system runs dashboard-only (LEX-27, RNF-009).
# DOMAINHUNTER_SMTP_HOST=smtp.example.com
# DOMAINHUNTER_SMTP_PORT=587
# DOMAINHUNTER_SMTP_SECURE=false
# DOMAINHUNTER_SMTP_USER=user
# DOMAINHUNTER_SMTP_PASS=secret
# DOMAINHUNTER_SMTP_FROM=domainhunter@domainhunter.local

# Authorized notification recipient (RNF-010). Emails are only sent to this
# address; omit to run dashboard-only.
# DOMAINHUNTER_NOTIFICATION_EMAIL_TO=me@example.com

# Automations worker.
# DOMAINHUNTER_POLL_MS=5000
# DOMAINHUNTER_WORKER_ID=automations-1

# Docker Compose: port published on localhost and link used by the dashboard.
# WEB_PORT=6645
# REGISTRO_BR_URL=https://registro.br/dominio/
